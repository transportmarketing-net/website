{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Payment brand strip using the existing RedStar palette.",
  "semantic": {
    "payments": {
      "surface": {
        "$type": "color",
        "$value": "#fff9f7"
      },
      "badge": {
        "$type": "color",
        "$value": "#ffffff"
      },
      "ink": {
        "$type": "color",
        "$value": "#17080a"
      },
      "muted": {
        "$type": "color",
        "$value": "#665457"
      },
      "line": {
        "$type": "color",
        "$value": "#ecd8d2"
      },
      "link": {
        "$type": "color",
        "$value": "#8f1111"
      }
    }
  },
  "space": {
    "payments": {
      "section": {
        "$type": "dimension",
        "$value": "48px"
      },
      "column": {
        "$type": "dimension",
        "$value": "48px"
      },
      "row": {
        "$type": "dimension",
        "$value": "24px"
      },
      "copy": {
        "$type": "dimension",
        "$value": "12px"
      },
      "badge": {
        "$type": "dimension",
        "$value": "12px"
      },
      "gap": {
        "$type": "dimension",
        "$value": "8px"
      },
      "gutter": {
        "$type": "dimension",
        "$value": "20px"
      },
      "label": {
        "$type": "dimension",
        "$value": "8px"
      },
      "outline": {
        "$type": "dimension",
        "$value": "3px"
      }
    }
  },
  "size": {
    "payments": {
      "container": {
        "$type": "dimension",
        "$value": "1180px"
      },
      "mark-width": {
        "$type": "dimension",
        "$value": "112px"
      },
      "mark-height": {
        "$type": "dimension",
        "$value": "64px"
      },
      "stripe-width": {
        "$type": "dimension",
        "$value": "76px"
      },
      "stripe-height": {
        "$type": "dimension",
        "$value": "32px"
      },
      "border": {
        "$type": "dimension",
        "$value": "1px"
      },
      "focus": {
        "$type": "dimension",
        "$value": "2px"
      }
    }
  },
  "font": {
    "family": {
      "payments": {
        "$type": "fontFamily",
        "$value": "Inter, Arial, sans-serif"
      }
    },
    "size": {
      "payments-body": {
        "$type": "dimension",
        "$value": "0.95rem"
      },
      "payments-heading": {
        "$type": "dimension",
        "$value": "1.75rem"
      },
      "payments-label": {
        "$type": "dimension",
        "$value": "0.75rem"
      },
      "payments-provider": {
        "$type": "dimension",
        "$value": "1.4rem"
      }
    },
    "weight": {
      "payments-strong": {
        "$type": "fontWeight",
        "$value": 700
      },
      "payments-medium": {
        "$type": "fontWeight",
        "$value": 600
      }
    },
    "leading": {
      "payments-body": {
        "$type": "number",
        "$value": 1.6
      },
      "payments-heading": {
        "$type": "number",
        "$value": 1.2
      }
    }
  },
  "radius": {
    "payments": {
      "$type": "dimension",
      "$value": "8px"
    }
  }
}
