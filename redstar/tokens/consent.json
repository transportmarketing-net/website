{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Shared consent banner, matching the existing RedStar crimson theme.",
  "primitive": {
    "ink": {
      "$type": "color",
      "$value": "#17080a"
    },
    "muted": {
      "$type": "color",
      "$value": "#665457"
    },
    "line": {
      "$type": "color",
      "$value": "#ecd8d2"
    },
    "surface": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "action": {
      "$type": "color",
      "$value": "#8f1111"
    }
  },
  "semantic": {
    "consent": {
      "ink": {
        "$type": "color",
        "$value": "{primitive.ink}"
      },
      "muted": {
        "$type": "color",
        "$value": "{primitive.muted}"
      },
      "line": {
        "$type": "color",
        "$value": "{primitive.line}"
      },
      "surface": {
        "$type": "color",
        "$value": "{primitive.surface}"
      },
      "action": {
        "$type": "color",
        "$value": "{primitive.action}"
      }
    }
  },
  "space": {
    "consent": {
      "offset": {
        "$type": "dimension",
        "$value": "20px"
      },
      "gap": {
        "$type": "dimension",
        "$value": "16px"
      },
      "compact": {
        "$type": "dimension",
        "$value": "8px"
      },
      "padding-x": {
        "$type": "dimension",
        "$value": "24px"
      },
      "button-x": {
        "$type": "dimension",
        "$value": "14px"
      },
      "focus": {
        "$type": "dimension",
        "$value": "3px"
      },
      "none": {
        "$type": "dimension",
        "$value": "0px"
      }
    }
  },
  "size": {
    "consent": {
      "max-width": {
        "$type": "dimension",
        "$value": "680px"
      },
      "gutter": {
        "$type": "dimension",
        "$value": "40px"
      },
      "height-reserve": {
        "$type": "dimension",
        "$value": "120px"
      },
      "button-height": {
        "$type": "dimension",
        "$value": "38px"
      },
      "border": {
        "$type": "dimension",
        "$value": "1px"
      },
      "focus": {
        "$type": "dimension",
        "$value": "2px"
      }
    }
  },
  "radius": {
    "consent": {
      "$type": "dimension",
      "$value": "8px"
    }
  },
  "shadow": {
    "consent": {
      "$type": "shadow",
      "$value": "0 18px 46px rgba(23,8,10,0.07)"
    }
  },
  "font": {
    "family": {
      "consent": {
        "$type": "fontFamily",
        "$value": "Inter, Arial, sans-serif"
      }
    },
    "size": {
      "consent-body": {
        "$type": "dimension",
        "$value": "0.88rem"
      },
      "consent-button": {
        "$type": "dimension",
        "$value": "0.85rem"
      }
    },
    "weight": {
      "consent": {
        "$type": "fontWeight",
        "$value": 600
      }
    },
    "leading": {
      "consent": {
        "$type": "number",
        "$value": 1.65
      }
    }
  },
  "opacity": {
    "consent-active": {
      "$type": "number",
      "$value": 0.85
    },
    "consent-disabled": {
      "$type": "number",
      "$value": 0.5
    }
  },
  "z": {
    "consent": {
      "$type": "number",
      "$value": 9999
    }
  }
}
