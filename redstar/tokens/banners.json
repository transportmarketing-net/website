{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Shared RedStar banner and enquiry form tokens.",
  "primitive": {
    "banner": {
      "ink": {
        "$type": "color",
        "$value": "#17080a"
      },
      "muted": {
        "$type": "color",
        "$value": "#665457"
      },
      "surface": {
        "$type": "color",
        "$value": "#fff9f7"
      },
      "white": {
        "$type": "color",
        "$value": "#ffffff"
      },
      "crimson": {
        "$type": "color",
        "$value": "#8f1111"
      },
      "night": {
        "$type": "color",
        "$value": "#2b0a0f"
      },
      "soft": {
        "$type": "color",
        "$value": "#fff1ee"
      },
      "line": {
        "$type": "color",
        "$value": "#ecd8d2"
      },
      "control": {
        "$type": "color",
        "$value": "#897275"
      },
      "rose": {
        "$type": "color",
        "$value": "#e8cbc7"
      }
    }
  },
  "semantic": {
    "banner": {
      "text": {
        "$type": "color",
        "$value": "{primitive.banner.ink}"
      },
      "muted": {
        "$type": "color",
        "$value": "{primitive.banner.muted}"
      },
      "surface": {
        "$type": "color",
        "$value": "{primitive.banner.surface}"
      },
      "paper": {
        "$type": "color",
        "$value": "{primitive.banner.white}"
      },
      "action": {
        "$type": "color",
        "$value": "{primitive.banner.crimson}"
      },
      "dark": {
        "$type": "color",
        "$value": "{primitive.banner.night}"
      },
      "soft": {
        "$type": "color",
        "$value": "{primitive.banner.soft}"
      },
      "line": {
        "$type": "color",
        "$value": "{primitive.banner.line}"
      },
      "control": {
        "$type": "color",
        "$value": "{primitive.banner.control}"
      },
      "on-dark": {
        "$type": "color",
        "$value": "{primitive.banner.white}"
      },
      "muted-on-dark": {
        "$type": "color",
        "$value": "{primitive.banner.rose}"
      }
    }
  },
  "component": {
    "banner": {
      "button-bg": {
        "$type": "color",
        "$value": "{semantic.banner.action}"
      },
      "button-text": {
        "$type": "color",
        "$value": "{semantic.banner.paper}"
      },
      "button-hover": {
        "$type": "color",
        "$value": "{semantic.banner.dark}"
      },
      "field-error": {
        "$type": "color",
        "$value": "{semantic.banner.action}"
      }
    }
  },
  "space": {
    "banner": {
      "section": {
        "$type": "dimension",
        "$value": "64px"
      },
      "gutter": {
        "$type": "dimension",
        "$value": "20px"
      },
      "column": {
        "$type": "dimension",
        "$value": "56px"
      },
      "stack": {
        "$type": "dimension",
        "$value": "24px"
      },
      "copy": {
        "$type": "dimension",
        "$value": "16px"
      },
      "compact": {
        "$type": "dimension",
        "$value": "8px"
      },
      "field": {
        "$type": "dimension",
        "$value": "12px"
      },
      "button-x": {
        "$type": "dimension",
        "$value": "24px"
      },
      "button-y": {
        "$type": "dimension",
        "$value": "12px"
      },
      "panel": {
        "$type": "dimension",
        "$value": "32px"
      },
      "focus": {
        "$type": "dimension",
        "$value": "4px"
      },
      "small": {
        "$type": "dimension",
        "$value": "4px"
      }
    }
  },
  "size": {
    "banner": {
      "container": {
        "$type": "dimension",
        "$value": "1180px"
      },
      "control": {
        "$type": "dimension",
        "$value": "48px"
      },
      "border": {
        "$type": "dimension",
        "$value": "1px"
      },
      "focus": {
        "$type": "dimension",
        "$value": "2px"
      },
      "trap": {
        "$type": "dimension",
        "$value": "1px"
      },
      "spinner": {
        "$type": "dimension",
        "$value": "20px"
      },
      "text": {
        "$type": "dimension",
        "$value": "65ch"
      },
      "anchor": {
        "$type": "dimension",
        "$value": "112px"
      }
    }
  },
  "font": {
    "family": {
      "banner": {
        "$type": "fontFamily",
        "$value": "Inter, Arial, sans-serif"
      },
      "banner-heading": {
        "$type": "fontFamily",
        "$value": "Manrope, Inter, Arial, sans-serif"
      }
    },
    "size": {
      "banner-heading": {
        "$type": "dimension",
        "$value": "2.25rem"
      },
      "banner-body": {
        "$type": "dimension",
        "$value": "1rem"
      },
      "banner-label": {
        "$type": "dimension",
        "$value": "0.875rem"
      },
      "banner-eyebrow": {
        "$type": "dimension",
        "$value": "0.75rem"
      }
    },
    "weight": {
      "banner-strong": {
        "$type": "fontWeight",
        "$value": 700
      },
      "banner-medium": {
        "$type": "fontWeight",
        "$value": 600
      }
    },
    "leading": {
      "banner-body": {
        "$type": "number",
        "$value": 1.65
      },
      "banner-heading": {
        "$type": "number",
        "$value": 1.2
      }
    }
  },
  "radius": {
    "banner": {
      "$type": "dimension",
      "$value": "8px"
    }
  },
  "opacity": {
    "banner-disabled": {
      "$type": "number",
      "$value": 0.5
    }
  },
  "motion": {
    "duration": {
      "banner-loading": {
        "$type": "duration",
        "$value": "800ms"
      }
    }
  }
}
